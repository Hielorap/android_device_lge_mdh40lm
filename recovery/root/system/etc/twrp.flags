# AB P OP
# mount point     			fstype			device                                           		flags
/     		            	    	ext4   			/dev/block/platform/bootdevice/by-name/system			flags=slotselect;backup=1;
/vendor 	      	        	ext4   			/dev/block/platform/bootdevice/by-name/vendor   		flags=slotselect;backup=1;
/product				ext4			/dev/block/platform/bootdevice/by-name/product			flags=slotselect;backup=1;
/data         	        		ext4    		/dev/block/platform/bootdevice/by-name/userdata 		flags=wipeingui;backup=1;
/misc            	    		emmc   			/dev/block/platform/bootdevice/by-name/para     		flags=backup=1;
/misc2              			emmc   			/dev/block/platform/bootdevice/by-name/misc2    			flags=backup=1;
/eksst                  		emmc   			/dev/block/platform/bootdevice/by-name/eksst              	flags=backup=1;
/encrypt				emmc   			/dev/block/platform/bootdevice/by-name/encrypt           	flags=backup=1;
/persistent            			emmc   			/dev/block/platform/bootdevice/by-name/frp         		flags=display="Persistent";backup=1;flashimg=1;
/fota                  			emmc   			/dev/block/platform/bootdevice/by-name/fota              	flags=backup=1;
/mnt/vendor/persist-lg 			ext4  			/dev/block/platform/bootdevice/by-name/persist_lg 		flags=backup=1;
/nvdata                  		ext4   			/dev/block/platform/bootdevice/by-name/nvdata 			flags=display="Nvdata";backup=1;
/els                 		    	ext4   			/dev/block/platform/bootdevice/by-name/els                	flags=backup=1;
/mpt                     		ext4   			/dev/block/platform/bootdevice/by-name/mpt               	flags=backup=1;
/mnt/product/carrier    		ext4   			/dev/block/platform/bootdevice/by-name/carrier            	flags=backup=1;
/mnt/product/persist-lg			ext4   			/dev/block/platform/bootdevice/by-name/p_persist_lg    		flags=backup=1;
/product/OP             	 	ext4   			/dev/block/platform/bootdevice/by-name/OP                 	flags=backup=1;
/scp1                    		emmc   			/dev/block/platform/bootdevice/by-name/scp1               	flags=backup=1;
/scp2                    		emmc   			/dev/block/platform/bootdevice/by-name/scp2               	flags=backup=1;
/sspm_1                  		emmc   			/dev/block/platform/bootdevice/by-name/sspm_1           	flags=backup=1;
/sspm_2                  		emmc   			/dev/block/platform/bootdevice/by-name/sspm_2           	flags=backup=1;
/spmfw                   		emmc   			/dev/block/platform/bootdevice/by-name/spmfw             	flags=backup=1;
/protect_f         	  		ext4      		/dev/block/platform/bootdevice/by-name/protect1                 flags=display="Protect_f";backup=1;
/protect_s         	  		ext4      		/dev/block/platform/bootdevice/by-name/protect2                 flags=display="Protect_s";backup=1;
/nvcfg           	      		ext4      		/dev/block/platform/bootdevice/by-name/nvcfg                    flags=display="Nvcfg";backup=1;
/persist     	          		ext4      		/dev/block/platform/bootdevice/by-name/persist                  flags=display="Persist";backup=1;
/nvram        		      		emmc      		/dev/block/platform/bootdevice/by-name/nvram                    flags=display="Nvram";backup=1;flashimg=1;
/proinfo	 			emmc      		/dev/block/platform/bootdevice/by-name/proinfo                 flags=backup=1;
/boot         		      		emmc      		/dev/block/platform/bootdevice/by-name/boot                     flags=display="Boot";backup=1;flashimg=1;slotselect;
/logo          		  		emmc      		/dev/block/platform/bootdevice/by-name/logo                     flags=display="Logo";backup=1;flashimg=1;
/expdb              	  		emmc      		/dev/block/platform/bootdevice/by-name/expdb                    flags=backup=1;
/seccfg       		      		emmc      		/dev/block/platform/bootdevice/by-name/seccfg                  flags=backup=1;

# vbmeta
/vbmeta                  		emmc      		/dev/block/platform/bootdevice/by-name/vbmeta                   flags=display="Vbmeta";flashimg=1;slotselect;backup=1;

# Removable
/external_sd            		auto         		/dev/block/mmcblk1p1		/dev/block/mmcblk1		flags=display="Micro SDcard";storage;backup=1;removable;
/usb-otg                  		vfat       	   	/dev/block/sda1       	    	/dev/block/sdd         		flags=display="USB-OTG";storage;backup=1;removable;
